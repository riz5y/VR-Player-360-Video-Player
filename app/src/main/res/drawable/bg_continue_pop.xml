<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#553C8CEF" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#6CC1FF"
                android:startColor="#2F86FF" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
