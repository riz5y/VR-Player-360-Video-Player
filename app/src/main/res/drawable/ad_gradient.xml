<?xml version="1.0" encoding="utf-8"?>
<!-- Vibrant dark-blue ad background — stands out on the dark onboarding screens -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="135"
        android:startColor="#0D1B3E"
        android:centerColor="#0F2251"
        android:endColor="#0A1830"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#3C8CEF" />
    <corners android:radius="10dp" />
</shape>
