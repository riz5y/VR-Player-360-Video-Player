<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VRPlayer1" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/AppActivityAnimation</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="AppActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <style name="AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:text">Ad</item>
        <item name="android:background">@color/colorBlue</item>
        <item name="android:width">20dp</item>
        <item name="android:height">20dp</item>
    </style>


    <style name="AdsButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/playbold</item>

        <!-- Colors -->
        <item name="backgroundTint">@color/yellow_color</item>
        <item name="android:textColor">@color/white</item>

        <!-- Shape -->
        <item name="cornerRadius">12dp</item>
    </style>


    <style name="Theme.VRPlayer1" parent="Base.Theme.VRPlayer1" />
</resources>