<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/all_corener_round"
    android:backgroundTint="@color/colorBlue"
    android:padding="10dp">


    <RelativeLayout
        android:id="@+id/rlImageApp"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/all_corener_round"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:padding="4dp"
        android:layout_marginEnd="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">

        <ImageView
            android:id="@+id/image_app"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitXY"

            />

    </RelativeLayout>

    <TextView
        android:id="@+id/titlePlaceName"
        style="Custom Notification Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_toEndOf="@+id/rlImageApp"
        android:layout_toStartOf="@+id/ad"
        android:text="title"
        android:textStyle="bold"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ad"
        style="Custom Notification Text"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:gravity="center"
        android:text="Ad"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/text"
        style="Custom Notification Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/titlePlaceName"
        android:layout_marginStart="5dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:layout_toEndOf="@+id/rlImageApp"
        android:layout_toStartOf="@+id/ad"
        android:ellipsize="end"
        android:gravity="start"
        android:lines="3"
        android:maxLines="3"
        android:text="text"
        android:textColor="@color/white"
        android:textSize="12sp" />


    <ImageView
        android:id="@+id/image_pic"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:scaleType="fitXY"
        android:layout_below="@+id/text"
        android:padding="5dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="9dp"
        />



</RelativeLayout>