<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:background="#000000">
    <androidx.cardview.widget.CardView
        android:id="@+id/panoramicControlsGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:elevation="6dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#66000000"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Zoom In -->
            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom In"
                android:padding="8dp"
                android:visibility="gone"
                android:src="@drawable/ic_zoom_in" />

            <!-- Re-centre -->
            <ImageButton
                android:id="@+id/btnPanoRecentre"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Re-centre"
                android:padding="8dp"
                android:src="@drawable/ic_recenter" />

            <!-- Zoom Out -->
            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom Out"
                android:padding="8dp"
                android:visibility="gone"
                android:src="@drawable/ic_zoom_out" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <android.opengl.GLSurfaceView
        android:id="@+id/glSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#55000000">

        <!-- ── TOP BAR: Back + Title ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/backbtn11"
                android:background="@drawable/bg_circle_dark"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Video Title"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/playbold"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btnRecentre"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:visibility="gone"
                android:src="@drawable/premiumiicon"
                android:background="@drawable/bg_circle_dark"
                android:padding="8dp"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- ── MIDDLE SPACER ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ── SEEKBAR ROW ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="40dp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:progressTint="#C6F135"
                android:thumbTint="#C6F135" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="40dp"
                android:gravity="end" />

        </LinearLayout>


        <!-- ── BOTTOM CONTROLS: Rewind + Play/Pause + Forward ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:paddingTop="8dp">

            <!-- Rewind 10s -->
            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_rewind_10"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                app:tint="#FFFFFF" />

            <!-- Play/Pause -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:padding="@dimen/_2sdp"
                android:src="@drawable/pause"
                android:background="@drawable/bg_circle_dark"
                android:scaleType="centerInside"
                app:tint="#FFFFFF" />

            <!-- Forward 10s -->
            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:padding="@dimen/_5sdp"
                android:layout_height="44dp"
                android:src="@drawable/ic_forward_10"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <ProgressBar
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminateTint="#C6F135" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Buffering…"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>