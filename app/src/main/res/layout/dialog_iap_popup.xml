<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_go_premium_popup"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ivIapHero"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scaleType="matrix"
        android:src="@drawable/popup_hero_c" />

    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/bg_paywall_fade" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Close button -->
    <ImageView
        android:id="@+id/btnCloseIapPopup"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Close"
        android:src="@drawable/ic_cancel_circle" />

    <!-- Crown icon (long-press for QA picker) — kept 0x0 so badge doesn't show -->
    <ImageView
        android:id="@+id/ivIapGift"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:src="@drawable/premiumvricon" />

    <!-- Go Premium title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:fontFamily="@font/nicomojiregular"
        android:text="Go Premium 👑"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Enjoy all features without any restrictions"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/montserratmedium" />

    <!-- Feature bullets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/whiittetick" app:tint="#3C8CEF" android:background="@drawable/bg_check_circle" android:padding="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Remove Ads" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/montserratmedium"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/whiittetick" app:tint="#3C8CEF" android:background="@drawable/bg_check_circle" android:padding="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Access All Features" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/montserratmedium"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/whiittetick" app:tint="#3C8CEF" android:background="@drawable/bg_check_circle" android:padding="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Unlimited Downloads" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/montserratmedium"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/whiittetick" app:tint="#3C8CEF" android:background="@drawable/bg_check_circle" android:padding="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Fast Response" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="@font/montserratmedium"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Weekly plan card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_feature_grid"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Weekly"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/montserratbold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs 550"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/montserratbold" />
    </LinearLayout>

    <!-- 3 Day Free Trial text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="3 Day Free Trial Then Weekly Rs 550"
        android:textColor="#C0ACAC"
        android:textSize="11sp"
        android:fontFamily="@font/montserratbold" />

    <!-- Gradient CTA button -->
    <TextView
        android:id="@+id/btnUnlockVip"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_gradient_cta"
        android:gravity="center"
        android:text="Try Free Rs 0.00"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/montserratbold"
        android:clickable="true"
        android:focusable="true" />

    <!-- Maybe Later / No Payment Now -->
    <TextView
        android:id="@+id/tvMaybeLater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="No Payment Now"
        android:textColor="#EDEAEA"
        android:textSize="12sp"
        android:fontFamily="@font/montserratmedium"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
</FrameLayout>
