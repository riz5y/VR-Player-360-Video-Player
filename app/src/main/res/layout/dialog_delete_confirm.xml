<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <!-- Trash icon -->
    <ImageView
        android:id="@+id/imgTrash"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/ic_delete_dialog"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvDeleteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Delete Downloaded Video"
        android:textColor="#0A0816"
        android:textSize="16sp"
        android:fontFamily="@font/playbold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/imgTrash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvDeleteSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="This VR video will be removed from your downloads."
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:fontFamily="@font/playregular"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@+id/tvDeleteTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Delete Button -->
    <TextView
        android:id="@+id/btnConfirmDelete"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_download_btn"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/playbold"
        android:gravity="center"
        android:text="Delete"
        android:textColor="#1A1A2E"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@+id/tvDeleteSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cancel -->
    <TextView
        android:id="@+id/btnCancelDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Cancel"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:fontFamily="@font/playregular"
        android:clickable="true"
        android:focusable="true"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@+id/btnConfirmDelete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>